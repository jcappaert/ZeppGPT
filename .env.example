# Copy this file to .env and add values from your own authenticated Zepp session.
# Never pass the token on the command line or commit the resulting .env file.
ZEPP_APP_TOKEN=
ZEPP_USER_ID=

# Use the exact HTTPS origin observed in the Zepp request, including any region
# suffix, for example: https://api-mifit-de.huami.com
ZEPP_API_HOST=

# Optional. Comma-separated additional Zepp/Huami origins to try after the
# primary host. Tokens are never sent to hosts outside zepp.com/huami.com.
ZEPP_API_HOSTS=

# Optional request settings.
ZEPP_REQUEST_TIMEOUT_SECONDS=20
ZEPP_SOURCE=run.mifit.huami.com
